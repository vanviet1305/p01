#!/bin/sh
#
# @name Gazebo x650 (X650 + MN4014 KV330 + 1555, 6S, uoc luong)
#
# @type Quadrotor
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=x650}

param set-default SIM_GZ_EN 1

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

param set-default CA_ROTOR0_PX 0.23
param set-default CA_ROTOR0_PY 0.23
param set-default CA_ROTOR0_KM 0.016

param set-default CA_ROTOR1_PX -0.23
param set-default CA_ROTOR1_PY -0.23
param set-default CA_ROTOR1_KM 0.016

param set-default CA_ROTOR2_PX 0.23
param set-default CA_ROTOR2_PY -0.23
param set-default CA_ROTOR2_KM -0.016

param set-default CA_ROTOR3_PX -0.23
param set-default CA_ROTOR3_PY 0.23
param set-default CA_ROTOR3_KM -0.016

param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

param set-default SIM_GZ_EC_MIN1 100
param set-default SIM_GZ_EC_MIN2 100
param set-default SIM_GZ_EC_MIN3 100
param set-default SIM_GZ_EC_MIN4 100

param set-default SIM_GZ_EC_MAX1 630
param set-default SIM_GZ_EC_MAX2 630
param set-default SIM_GZ_EC_MAX3 630
param set-default SIM_GZ_EC_MAX4 630

param set-default MPC_THR_HOVER 0.45
# Bay bằng node ROS 2, không dùng QGC: không yêu cầu kết nối GCS (tránh 'Arming denied' sau mỗi lần nạp lại tham số)
param set-default NAV_DLL_ACT 0

# Drag Specific Force:
param set-default EKF2_BCOEF_X 0.0
param set-default EKF2_BCOEF_Y 0.0
param set-default EKF2_MCOEF 0.12
